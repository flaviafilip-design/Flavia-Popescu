{
 "r": "<script>\n(function(){\n var fc=document.getElementById('fc'); if(!fc) return;\n var intro=document.getElementById('motorul-de-reels'), band=fc.querySelector('.fc-band'), faq=fc.querySelector('.fc-faq');\n if(!intro||!band||!faq) return;\n if(intro.compareDocumentPosition(band)&Node.DOCUMENT_POSITION_FOLLOWING) return;\n var nodes=[]; for(var n=intro;n;n=n.nextSibling){nodes.push(n); if(n===faq) break;}\n var frag=document.createDocumentFragment(); nodes.forEach(function(x){frag.appendChild(x);});\n band.parentNode.insertBefore(frag,band);\n var lab=intro.querySelector('.label'); if(lab) lab.textContent='Cursul nou · Pentru cine face conținut';\n var p=intro.querySelector('p.d2'); if(p) p.textContent='Dacă faci conținut, aici îți arăt cum lași AI-ul să-ți editeze reel-urile: tu filmezi, el taie, pune subtitrările și îți dă video-ul gata de postat.';\n var tg=fc.querySelector('.fc-hero-copy .tagline'); if(tg) tg.innerHTML='Reels editate de AI, cursuri AI și <em>joburi remote.</em>';\n var ld=fc.querySelector('.fc-hero-copy .lede'); if(ld) ld.textContent='Cursuri, ghiduri și servicii în română. Ca să-ți editezi reel-urile fără ore pierdute în CapCut, să folosești AI în munca ta și să găsești un job remote internațional.';\n var cta=fc.querySelector('.fc-hero-copy .cta-row'); if(cta) cta.innerHTML='<a class=\"btn\" href=\"#motorul-de-reels\">Motorul de Reels</a><a class=\"btn ghost\" href=\"#section-fl-ai\">Cursuri AI</a>';\n var nav=fc.querySelector('.fc-nav'), a=nav&&nav.querySelector('a[href=\"#motorul-de-reels\"]'), s=nav&&nav.querySelector('.script');\n if(a&&s) s.after(a);\n})();\n</script>\n",
 "w": "<!-- Motorul de Reels public la 127 € (de vineri 30 oct) -->\n<script>\n(function(){\n var fc=document.getElementById('fc'); if(!fc||fc.getAttribute('data-mdr-open')) return; fc.setAttribute('data-mdr-open','1');\n var PAGE='/motorul-de-reels', CHK='https://www.flaviapopescu.eu/offers/oVEQCkep/checkout';\n fc.querySelectorAll('.fc-ann-track span').forEach(function(s,i){ s.textContent = i%2 ? 'Motorul de Reels: plătești o singură dată' : 'Motorul de Reels e deschis'; });\n var intro=document.getElementById('motorul-de-reels');\n if(intro){ intro.querySelectorAll('p').forEach(function(p){ if(/prețul promoțional/.test(p.textContent)) p.remove(); }); var lab=intro.querySelector('.label'); if(lab) lab.textContent='E deschis · Pentru cine face conținut';\n  var btn=intro.querySelector('a.btn'); if(btn){ btn.textContent='Vezi Motorul de Reels'; btn.setAttribute('href',PAGE); }\n  var q=document.createElement('p'); q.innerHTML='<strong>Motorul de Reels e deschis.</strong> 127 €, plătești o singură dată.'; if(btn) btn.before(q); }\n var of=document.getElementById('oferta');\n if(of){ var h2=of.querySelector('h2'); if(h2) h2.innerHTML='E <em>deschis</em>';\n  var card=of.querySelector('.card');\n  if(card){ var l=card.querySelector('.label'); if(l) l.textContent='Acces pentru totdeauna';\n   card.querySelectorAll('p:not(.label)').forEach(function(p){p.remove();});\n   var a=card.querySelector('a.btn'); var pr=document.createElement('p'); pr.className='price'; pr.textContent='127 €';\n   var t=document.createElement('p'); t.textContent='Motorul, cursul și toate actualizările. Plătești o singură dată.';\n   if(a){ a.before(pr); a.before(t); a.textContent='Vreau Motorul de Reels'; a.setAttribute('href',CHK); a.removeAttribute('target'); } } }\n fc.querySelectorAll('.fc-move p').forEach(function(p){ if(/lista de așteptare/.test(p.textContent)) p.textContent='Tu filmezi, AI-ul editează. E deschis acum.'; });\n fc.querySelectorAll('a[href*=\"remotecoaches.kit.com/000648c0b4\"]').forEach(function(a){ a.setAttribute('href',PAGE); a.removeAttribute('target'); if(/listă|așteptare/i.test(a.textContent)) a.textContent='Vezi Motorul de Reels'; });\n})();\n</script>",
 "s": "<style>\n.fc .mdr-studio{background:var(--white,#FFFDFB)}\n.fc .mdr-studio .inner{max-width:1180px;margin-inline:auto}\n.fc .mdr-studio .sec-head{text-align:center;max-width:760px;margin:0 auto 34px}\n.fc .mdr-studio .sec-head p{margin-top:14px}\n.fc .mdr-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:0 auto 34px}\n.fc .mdr-steps div{background:var(--cream,#F6F0EA);border-radius:22px;padding:20px 18px}\n.fc .mdr-steps b{display:block;font-family:\"Anton\",\"Arial Narrow\",Impact,sans-serif;font-weight:400;font-size:2.2rem;line-height:1;color:var(--crimson,#A10728)}\n.fc .mdr-steps span{display:block;margin-top:8px;font-size:1rem;line-height:1.4}\n.fc .mdr-gal{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}\n.fc .mdr-gal figure{margin:0}\n.fc .mdr-gal img{width:100%;height:auto;display:block;border-radius:18px;box-shadow:0 18px 44px rgba(59,47,42,.16);background:#fff}\n.fc .mdr-gal figcaption{font-size:.95rem;opacity:.75;text-align:center;margin-top:10px}\n.fc .mdr-chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:900px;margin:26px auto 0}\n.fc .mdr-chips span{border:1.5px solid rgba(59,47,42,.18);border-radius:999px;padding:7px 15px;font-size:.92rem;background:#fff}\n.fc .mdr-cta{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:30px}\n@media(max-width:860px){.fc .mdr-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.fc .mdr-gal{grid-template-columns:1fr}}\n</style>\n<script>\n(function(){\n function run(){\n var fc=document.getElementById('fc'); if(!fc||fc.getAttribute('data-mdr-studio')) return; fc.setAttribute('data-mdr-studio','1');\n var PAGE='/motorul-de-reels', CDN='https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/sites/2148933892/images/';\n var intro=document.getElementById('motorul-de-reels'); if(!intro) return;\n var btn=intro.querySelector('a.btn');\n if(btn && !intro.querySelector('a[data-mdr-more]')){ var more=document.createElement('a'); more.className='btn ghost'; more.setAttribute('data-mdr-more','1'); more.href=PAGE; more.textContent='Vezi tot ce face motorul'; more.style.cssText='margin:12px 0 0 10px;background:transparent;color:#F6E6E5;border:1.5px solid #F6E6E5;'; btn.after(more); }\n var fig=function(img,alt,cap){return '<figure><img src=\"'+CDN+img+'\" alt=\"'+alt+'\" loading=\"lazy\"><figcaption>'+cap+'</figcaption></figure>';};\n var sec=document.createElement('section'); sec.className='sec wrap mdr-studio'; sec.id='ce-face-motorul';\n sec.innerHTML='<div class=\"inner\"><div class=\"sec-head\"><p class=\"label\">Ce face motorul</p><h2>Tu filmezi. <em>Alegi tot pe o pagină.</em></h2>'\n  +'<p>Trimiți clipul filmat cu telefonul. Motorul taie pauzele și reluările, pune subtitrările, titlul, efectele și sunetele. Înainte să facă reelul îți deschide Studioul reelului, o singură pagină în care vezi tot și alegi tot cu click-uri.</p></div>'\n  +'<div class=\"mdr-steps\"><div><b>1</b><span>Filmezi cu telefonul, cum vorbești cu o prietenă.</span></div><div><b>2</b><span>Răspunzi la 4 întrebări cu butoane.</span></div><div><b>3</b><span>Alegi totul în Studioul reelului.</span></div><div><b>4</b><span>Apeși Gata. Primești reelul, coperta și textul postării.</span></div></div>'\n  +'<div class=\"mdr-gal\">'\n  +fig('68ed7-0752-2be7-b3f0-cc7f6e020088_mdr-studio-intrebari.jpg','Cele 4 întrebări cu butoane','La început: 4 întrebări cu butoane. Apeși, nu scrii.')\n  +fig('42b361-188-8a0b-6453-e37a3db187e2_mdr-studio-cuts.jpg','Tăieturile cuvânt cu cuvânt','Tai cuvânt cu cuvânt. Reluările și pauzele sunt deja scoase.')\n  +fig('cb55fe-c13a-d802-74a-4f0bf4d88bd_mdr-studio-fonts.jpg','Fonturile pentru titlu și subtitrări','55 de fonturi și 22 de animații, văzute pe loc.')\n  +fig('af44a4-1c4e-60ef-8c1-bbab6f5aa8a_mdr-studio-gif.jpg','GIF-uri de reacție','GIF-uri de reacție, stickere desenate și peste 470 de efecte.')\n  +'</div><div class=\"mdr-chips\"><span>Tăieturi cuvânt cu cuvânt</span><span>Subtitrări care nu-ți acoperă fața</span><span>Efecte care îți urmăresc mâinile</span><span>Peste 100 de stickere</span><span>GIF-uri de reacție</span><span>11 filtre</span><span>Merge în Claude și ChatGPT</span></div>'\n  +'<div class=\"mdr-cta\"><a class=\"btn\" href=\"'+PAGE+'\">Vezi tot ce face motorul</a></div></div>';\n intro.after(sec);\n fc.querySelectorAll('.fc-move').forEach(function(a){ var h=a.querySelector('h3'); if(h&&/Motorul/.test(h.textContent)){ var p=a.querySelector('p:not(.label)'); if(p) p.textContent='Tu filmezi, AI-ul editează. Alegi totul pe o singură pagină, Studioul reelului.'; } });\n }\n if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',function(){setTimeout(run,0)}); else setTimeout(run,0);\n})();\n</script>\n",
 "d": "<style>.mdr-demo-sec .mdr-demo-wrap{max-width:1000px;margin:26px auto 0}.mdr-demo-sec .mdr-demo-wrap .mdr-demo{width:100%!important;max-width:100%!important;border-radius:18px;overflow:hidden;box-shadow:0 18px 44px rgba(59,47,42,.16);background:#000}.mdr-demo-sec .mdr-demo-note{max-width:760px;margin:18px auto 0;text-align:center}.mdr-demo-sec .sec-head{text-align:center}</style><script>(function(){var n=0;function go(){var v=document.querySelector('.mdr-demo');var anchor=document.querySelector('#ce-face-motorul');if(!v||!anchor){if(n++<60)setTimeout(go,200);return;}if(v.getAttribute('data-moved'))return;v.setAttribute('data-moved','1');var s=document.createElement('section');s.className='sec wrap mdr-demo-sec';s.id='demo-motorul';s.innerHTML='<div class=\"inner\"><div class=\"sec-head\"><p class=\"label\">Demo · Motorul de Reels</p><h2>Uite cum merge, <em>în mai puțin de 2 minute</em></h2><p>De la clipul filmat cu telefonul la reelul gata de postat. Fără CapCut.</p></div><div class=\"mdr-demo-wrap\"></div><p class=\"mdr-demo-note\">Studioul e opțional. E ca un CapCut în care doar alegi ce-ți place. Dacă nu vrei să alegi nimic, îi spui „editează-l tu” și face el tot reelul. Iar stilul tău i-l spui o singură dată și îl ține minte.</p><p class=\"mdr-demo-note\">Și nu e doar pentru reeluri în care vorbești la cameră: face reeluri și din clipurile cu produsul sau lucrarea ta, fără să spui un cuvânt. Iar din același reel primești și un carusel și story-uri.</p></div>';anchor.parentNode.insertBefore(s,anchor);s.querySelector('.mdr-demo-wrap').appendChild(v);}if(document.readyState!=='loading')go();else document.addEventListener('DOMContentLoaded',go);})();</script>",
 "x": "<style>\n.fc .rc-prog{background:var(--pink);border-radius:40px;padding:clamp(28px,4vw,56px);max-width:1140px;margin-inline:auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,4vw,56px);align-items:start}\n.fc .rc-prog ul{margin:0;padding-left:1.2rem;display:grid;gap:.45rem}\n.fc .rc-prog .g{background:var(--white);border-radius:18px;padding:1rem 1.2rem}\n.fc .rc-prog .txt{display:grid;gap:1rem;justify-items:start}\n@media (max-width:900px){.fc .rc-prog{grid-template-columns:1fr}}\n</style>\n<script>\n(function(){\n var fc=document.getElementById('fc'); if(!fc) return;\n var ann=fc.querySelector('.fc-ann-track');\n if(ann){var a='Job remote international, din Romania',b='Program nou: Job Remote in 90 de zile, cu garantie',h='';for(var i=0;i<4;i++){h+='<span>'+a+'</span><span>'+b+'</span>';}ann.innerHTML=h;}\n var tg=fc.querySelector('.fc-hero-copy .tagline'); if(tg) tg.innerHTML='Job remote international, <em>fara sa pleci din Romania.</em>';\n var ld=fc.querySelector('.fc-hero-copy .lede'); if(ld) ld.textContent='Am lucrat 6 ani in companii remote internationale precum Deel, Remote si Papaya Global. Stiu ce cauta un recrutor si iti arat exact ce sa schimbi la CV, LinkedIn si interviu, ca sa ajungi la un salariu international.';\n var cr=fc.querySelector('.fc-hero-copy .cta-row'); if(cr) cr.innerHTML='<a class=\"btn\" href=\"#program-90\">Job Remote in 90 de zile</a><a class=\"btn ghost\" href=\"#section-fl-jobs\">Toate optiunile</a>';\n var t1=fc.querySelector('.fc-tag.t1'); if(t1) t1.textContent='Joburi remote internationale';\n var t3=fc.querySelector('.fc-tag.t3'); if(t3) t3.textContent='CV si interviu cu AI';\n function card(href,html){var a=fc.querySelector('a[href*=\"'+href+'\"]'); if(!a) return; var c=a.closest('article'); if(c) c.innerHTML=html;}\n card('htZ2y4U9','<p class=\"label\">Primul pas · 7 zile</p><h3>Kitul <em>Job Remote</em></h3><p>100 de companii remote-first, template de CV ATS, checklist LinkedIn in 15 pasi, 10 mesaje catre recrutori si planul de 7 zile.</p><p class=\"price\">27 €</p><a class=\"btn\" href=\"https://www.flaviapopescu.eu/offers/3DKRXN3L/checkout\">Vreau kitul</a>');\n card('z2uCEuKA','<p class=\"label\">Sesiune · 45 minute</p><h3>Sesiune de <em>strategie</em></h3><p>Analizam CV-ul si LinkedIn-ul inainte de apel. Pleci cu 3 pasi clari. Cei 97 € se scad din orice pachet de peste 350 €, in 7 zile.</p><p class=\"price\">97 €</p><a class=\"btn\" href=\"https://www.flaviapopescu.eu/offers/dnWSMKFM/checkout\">Rezerv sesiunea</a>');\n var paths=document.getElementById('section-fl-paths');\n if(paths && !document.getElementById('program-90')){\n  var s=document.createElement('section'); s.className='sec wrap'; s.id='program-90';\n  s.innerHTML='<div class=\"sec-head\"><p class=\"label\">Programul complet</p><h2>Job Remote in <em>90 de zile</em></h2><p>Pentru cine vrea rezultatul, nu doar informatia.</p></div><div class=\"rc-prog\"><div class=\"txt\"><p>Noi iti scriem CV-ul si LinkedIn-ul. Yago, asistentul nostru cu AI, te ajuta la fiecare aplicatie si te pregateste de interviu. Tu aplici dupa plan.</p><ul><li>CV &amp; LinkedIn Done for you, optimizate ATS <b>(375 €)</b></li><li>Challenge-ul de 5 zile <b>(97 €)</b></li><li>Yago 90 de zile: CV Lab, evaluator LinkedIn, interviu cu AI</li><li>Cele 2 cursuri de AI <b>(175 €)</b></li><li>2 sesiuni video: start si simulare de interviu <b>(194 €)</b></li><li>Feedback pe WhatsApp 90 de zile <b>(300 €)</b></li></ul></div><div class=\"txt\"><figure class=\"fc-q\" style=\"width:auto;margin:0\"><blockquote>Am fost personal la 5 manageri de la 5 companii, iar la 3 dintre ei am obtinut interviul. Si am fost acceptat. Toti mi-au spus ca au fost atrasi de primele 3 fraze din CV.</blockquote><figcaption>Mesaj real</figcaption></figure><p><s style=\"opacity:.6\">Valoare: peste 1.140 €</s></p><p class=\"price\">1.497 €</p><p class=\"rate\">sau 3 rate lunare de 549 €</p><p class=\"g\"><b>Garantie:</b> daca aplici dupa plan si nu primesti niciun interviu in 90 de zile, lucram cu tine gratuit pana primesti.</p><div class=\"cta-row\"><a class=\"btn\" href=\"https://www.flaviapopescu.eu/offers/FkuewFSZ/checkout\">Vreau programul</a><a class=\"btn ghost\" href=\"https://www.flaviapopescu.eu/offers/aBLM4Qgo/checkout\">In 3 rate</a></div></div></div>';\n  paths.parentNode.insertBefore(s,paths);\n }\n var of=document.getElementById('oferta');\n if(of){var cd=of.querySelector('.cards1'); var hd=of.querySelector('.sec-head h2'); if(hd) hd.innerHTML='Motorul de Reels e <em>deschis</em>'; if(cd) cd.innerHTML='<article class=\"card pink\"><p class=\"label\">Curs · Platesti o singura data</p><h3>Motorul de <em>Reels</em></h3><p>Motorul, cursul si toate actualizarile. Merge in Claude, Codex sau ChatGPT.</p><p class=\"price\">127 €</p><a class=\"btn\" href=\"https://www.flaviapopescu.eu/offers/oVEQCkep/checkout\">Vreau Motorul de Reels</a></article>';}\n fc.querySelectorAll('a[href=\"#oferta\"]').forEach(function(a){if(/list/i.test(a.textContent)) a.textContent='Vezi Motorul de Reels';});\n})();\n</script>\n"
}